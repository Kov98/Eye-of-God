<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls" xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles">
  <Style x:Key="{x:Type ctrls:NonClientButton}" BasedOn="{x:Static styles:ShellInternalStyles.PathButton}" TargetType="{x:Type ctrls:NonClientButton}">
    <Setter Property="ctrls:Button.CornerRadius" Value="{x:Static styles:CornerRadii.None}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="{x:Static styles:Sizes.NonClientControlHeight}" />
    <Setter Property="ctrls:Button.Kind" Value="Subtle" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Width" Value="{x:Static styles:Sizes.NonClientControlWidth}" />
  </Style>
</ResourceDictionary>