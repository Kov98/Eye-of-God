<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls" xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles">
  <Style x:Key="{x:Type ctrls:TabItem}" TargetType="{x:Type ctrls:TabItem}">
    <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillTransparentBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeTransparentBrushKey}}" />
    <Setter Property="BorderThickness" Value="{x:Static styles:StrokeWidths.Thin}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Static styles:ShellStyles.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextFillPrimaryBrushKey}}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="{x:Static styles:Sizes.ControlMinHeight}" />
    <Setter Property="MinWidth" Value="{x:Static styles:Sizes.ControlMinWidth}" />
    <Setter Property="Padding" Value="{x:Static styles:Spacings.HorizontalM}" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:TabItem}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{x:Static styles:CornerRadii.M}">
            <DockPanel LastChildFill="False">
              <ctrls:Indicator x:Name="Indicator" Orientation="Vertical" Height="{Binding ActualHeight, ElementName=Header}" />
              <ContentPresenter Name="Header" ContentSource="Header" Margin="{TemplateBinding Control.Padding}" MinHeight="{x:Static styles:Sizes.ContentMinHeight}" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="TabItem.IsSelected" Value="False">
              <Setter TargetName="Indicator" Property="Border.Background" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="TabItem.TabStripPlacement" Value="Top">
              <Setter TargetName="Indicator" Property="DockPanel.Dock" Value="Bottom" />
              <Setter TargetName="Indicator" Value="{x:Static ctrls:Indicator.ControlWidth}" Property="Height" />
              <Setter TargetName="Indicator" Property="ctrls:Indicator.Orientation" Value="Horizontal" />
              <Setter TargetName="Indicator" Property="Width" Value="{Binding ActualWidth, ElementName=Header}" />
              <Setter TargetName="Header" Property="DockPanel.Dock" Value="Bottom" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextFillDisabledBrushKey}}" />
      </Trigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.SubtleFillSecondaryBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeSecondaryBrushKey}}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>