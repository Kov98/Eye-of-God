<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls" xmlns:cvrts="clr-namespace:Microsoft.VisualStudio.Shell.Converters" xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles">
  <Style x:Key="ComboBoxEditableTextBoxStyle" TargetType="{x:Type ctrls:TextBox}">
    <Setter Property="UIElement.AllowDrop" Value="True" />
    <Setter Property="BorderThickness" Value="{x:Static styles:StrokeWidths.None}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
    <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
    <Setter Property="TextBoxBase.IsReadOnly" Value="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}" />
    <Setter Property="Margin" Value="{x:Static styles:Spacings.BottomXXXS}" />
    <Setter Property="MinHeight" Value="{x:Static styles:Sizes.ContentMinHeight}" />
    <Setter Property="MinWidth" Value="{x:Static styles:Sizes.ContentMinWidth}" />
    <Setter Property="Padding" Value="{x:Static styles:Spacings.LeftXS}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillSelectedTextBackgroundBrushKey}}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:TextBox}">
          <Grid Margin="{x:Static styles:Spacings.VerticalXXXSInvert}">
            <ctrls:ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Control.Padding}" />
            <Border Padding="{x:Static styles:Spacings.HorizontalXXS}">
              <TextBlock Name="HintText" Foreground="{DynamicResource {x:Static styles:ShellColors.TextFillSecondaryBrushKey}}" HorizontalAlignment="Left" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" Text="{TemplateBinding ctrls:TextBox.HintText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="HintText" Value="{DynamicResource {x:Static styles:ShellColors.TextFillDisabledBrushKey}}" Property="TextBlock.Foreground" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
              <Setter TargetName="HintText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="HintText" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ctrls:ComboBox}" TargetType="{x:Type ctrls:ComboBox}">
    <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillDefaultBrushKey}}" />
    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeDefaultBrushKey}}" />
    <Setter Property="BorderThickness" Value="{x:Static styles:StrokeWidths.Thin}" />
    <Setter Property="ctrls:ComboBox.CornerRadius" Value="{x:Static styles:CornerRadii.M}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Static styles:ShellStyles.FocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextFillPrimaryBrushKey}}" />
    <Setter Property="ComboBox.MaxDropDownHeight" Value="{x:Static ctrls:ComboBox.PopupMaxHeight}" />
    <Setter Property="MinHeight" Value="{x:Static styles:Sizes.ControlMinHeight}" />
    <Setter Property="MinWidth" Value="{x:Static ctrls:ComboBox.ControlMinWidth}" />
    <Setter Property="Padding" Value="{x:Static styles:Spacings.LeftSNudge}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="FrameworkElement.UseLayoutRounding" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel IsVirtualizing="{TemplateBinding VirtualizingPanel.IsVirtualizing}" VirtualizationMode="{TemplateBinding VirtualizingPanel.VirtualizationMode}" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:ComboBox}">
          <Grid Name="ControlGrid">
            <UIElement.Clip>
              <MultiBinding Converter="{x:Static cvrts:Converters.ClipConverter}">
                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                <Binding Path="CornerRadius" RelativeSource="{RelativeSource TemplatedParent}" />
              </MultiBinding>
            </UIElement.Clip>
            <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding ctrls:ComboBox.CornerRadius}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition MinWidth="{x:Static styles:Sizes.ControlMinWidth}" Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctrls:TextBox x:Name="PART_EditableTextBox" Grid.Column="0" HintText="{TemplateBinding ctrls:ComboBox.HintText}" ToolTip="{TemplateBinding FrameworkElement.ToolTip}" ToolTipService.VerticalOffset="{x:Static ctrls:TextBox.ToolTipOffset}" Visibility="Collapsed" Style="{StaticResource ComboBoxEditableTextBoxStyle}" />
                <ContentPresenter Name="DisplayedItem" Grid.Column="0" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" IsHitTestVisible="False" Margin="{TemplateBinding Control.Padding}" MinHeight="{x:Static styles:Sizes.ContentMinHeight}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="Center" />
                <ToggleButton Name="ToggleButton" Grid.Column="0" Grid.ColumnSpan="2" DataContext="{TemplateBinding ctrls:ComboBox.Placement}" Style="{x:Static styles:ShellInternalStyles.ComboBoxToggleButton}" />
              </Grid>
            </Border>
            <Rectangle Name="TypingIndicator" Fill="{DynamicResource {x:Static styles:ShellColors.AccentFillDefaultBrushKey}}" Height="{x:Static ctrls:TextBox.TypingIndicatorHeightTyping}" Stretch="Fill" VerticalAlignment="Bottom" Visibility="Hidden" />
            <ctrls:Popup x:Name="PART_Popup" EnableMenuMode="True" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" MinWidth="{Binding ActualWidth, ElementName=ControlGrid}" PlacementTarget="{Binding ElementName=ControlGrid}">
              <ctrls:ScrollViewer>
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" Margin="{x:Static styles:Spacings.XSNudge}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </ctrls:ScrollViewer>
            </ctrls:Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ItemsControl.HasItems" Value="False">
              <Setter TargetName="PART_Popup" Value="{x:Static ctrls:ComboBox.PopupMinHeight}" Property="MinHeight" />
            </Trigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
              <Setter TargetName="DisplayedItem" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="ToggleButton" Property="Grid.Column" Value="1" />
              <Setter TargetName="ToggleButton" Property="Grid.ColumnSpan" Value="1" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ComboBox.IsEditable" Value="True" />
                <Condition Property="UIElement.IsKeyboardFocusWithin" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TypingIndicator" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="ComboBox.IsEditable" Value="True" />
                <Condition Property="Validation.HasError" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="TypingIndicator" Property="Visibility" Value="Hidden" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ComboBox.IsDropDownOpen" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillTertiaryBrushKey}}" />
      </Trigger>
      <Trigger Property="ComboBox.IsEditable" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextFillPrimaryBrushKey}}" />
        <Setter Property="IsTabStop" Value="False" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextFillDisabledBrushKey}}" />
      </Trigger>
      <Trigger Property="ItemsControl.IsGrouping" Value="True">
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
      </Trigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillSecondaryBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeSecondaryBrushKey}}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ComboBox.IsEditable" Value="True" />
          <Condition Property="UIElement.IsKeyboardFocusWithin" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillActiveInputBrushKey}}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ComboBox.IsEditable" Value="True" />
          <Condition Property="Validation.HasError" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.SystemFillCriticalBrushKey}}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>