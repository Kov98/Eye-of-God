<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls;assembly=Microsoft.VisualStudio.Shell.Styles" xmlns:cvrts="clr-namespace:Microsoft.VisualStudio.Shell.Converters;assembly=Microsoft.VisualStudio.Shell.Styles" xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles;assembly=Microsoft.VisualStudio.Shell.Styles" xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI">
  <Style x:Key="{x:Static vs:VsToolBar.SeparatorStyleKey}" TargetType="{x:Type vs:VsButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.DividerStrokeDefaultBrushKey}}" />
    <Setter Property="Margin" Value="{x:Static styles:Spacings.XXS}" />
    <Setter Property="Padding" Value="{x:Static styles:Spacings.VerticalXSNudge}" />
    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={x:Static cvrts:Converters.BooleanVisibilityConverter}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <ctrls:Separator Margin="{TemplateBinding Control.Padding}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="Vertical" Binding="{Binding ParentToolBar.Orientation, RelativeSource={RelativeSource Self}}" />
          <Condition Value="False" Binding="{Binding (ToolBar.IsOverflowItem), RelativeSource={RelativeSource Self}}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Padding" Value="{x:Static styles:Spacings.HorizontalXSNudge}" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>