<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls" xmlns:cvrts="clr-namespace:Microsoft.VisualStudio.Shell.Converters" xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles">
  <Style x:Key="ScrollDirectionalButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillTransparentBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrongFillDefaultBrushKey}}" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{TemplateBinding Control.Background}">
            <Path Data="{TemplateBinding ContentControl.Content}" Fill="{TemplateBinding Control.Foreground}" Height="{x:Static styles:Sizes.IconS}" Width="{x:Static styles:Sizes.IconS}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ctrls:ScrollBar}}}">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{DynamicResource {x:Static styles:ShellColors.ControlFillTransparentBrushKey}}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrongFillDefaultBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="{x:Static ctrls:ScrollBar.ScrollThumbSize}" />
    <Setter Property="MinWidth" Value="{x:Static ctrls:ScrollBar.ScrollThumbSize}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="#00FFFFFF" Padding="{TemplateBinding Control.Padding}">
            <Border Name="Thumb" Background="{TemplateBinding Control.Background}" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" MinWidth="{TemplateBinding FrameworkElement.MinWidth}" />
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="Horizontal" Binding="{Binding}">
              <Setter TargetName="Thumb" Property="Border.CornerRadius" Value="{Binding ActualHeight, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.5, RelativeSource={RelativeSource Self}}" />
            </DataTrigger>
            <DataTrigger Value="Vertical" Binding="{Binding}">
              <Setter TargetName="Thumb" Property="Border.CornerRadius" Value="{Binding ActualWidth, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.5, RelativeSource={RelativeSource Self}}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrongFillDisabledBrushKey}}" />
      </Trigger>
      <DataTrigger Value="True" Binding="{Binding AlwaysExpanded, RelativeSource={RelativeSource AncestorType={x:Type ctrls:ScrollBar}}}">
        <Setter Property="MinHeight" Value="{x:Static ctrls:ScrollBar.ScrollThumbExpandedSize}" />
        <Setter Property="MinWidth" Value="{x:Static ctrls:ScrollBar.ScrollThumbExpandedSize}" />
      </DataTrigger>
      <DataTrigger Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ctrls:ScrollBar}}}">
        <Setter Property="MinHeight" Value="{x:Static ctrls:ScrollBar.ScrollThumbExpandedSize}" />
        <Setter Property="MinWidth" Value="{x:Static ctrls:ScrollBar.ScrollThumbExpandedSize}" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="False" Binding="{Binding AreDynamicScrollBarsEnabled, Source={x:Static styles:VisualOptions.Instance}}" />
          <Condition Value="Horizontal" Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ctrls:ScrollBar}}}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="VerticalAlignment" Value="Stretch" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="False" Binding="{Binding AreDynamicScrollBarsEnabled, Source={x:Static styles:VisualOptions.Instance}}" />
          <Condition Value="Vertical" Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ctrls:ScrollBar}}}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ctrls:ScrollBar}">
    <Border Background="{TemplateBinding Control.Background}" CornerRadius="{Binding ActualHeight, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.5, RelativeSource={RelativeSource Self}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="{x:Static ctrls:ScrollBar.ScrollButtonSize}" Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition MinWidth="{x:Static ctrls:ScrollBar.ScrollButtonSize}" Width="Auto" />
        </Grid.ColumnDefinitions>
        <RepeatButton Grid.Column="0" AutomationProperties.Name="{x:Static styles:Resources.ScrollLeft}" Command="{x:Static ScrollBar.LineLeftCommand}" Content="{x:Static styles:Geometries.ScrollBarLeftArrow}" Style="{StaticResource ScrollDirectionalButtonStyle}" />
        <Track Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollPageButtonStyle}" />
          </Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollPageButtonStyle}" />
          </Track.IncreaseRepeatButton>
          <Track.Thumb>
            <Thumb DataContext="{TemplateBinding ScrollBar.Orientation}" HorizontalAlignment="Stretch" Padding="{TemplateBinding Control.Padding}" Style="{StaticResource ThumbStyle}" />
          </Track.Thumb>
        </Track>
        <RepeatButton Grid.Column="2" AutomationProperties.Name="{x:Static styles:Resources.ScrollRight}" Command="{x:Static ScrollBar.LineRightCommand}" Content="{x:Static styles:Geometries.ScrollBarRightArrow}" Style="{StaticResource ScrollDirectionalButtonStyle}" />
      </Grid>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ctrls:ScrollBar}">
    <Border Background="{TemplateBinding Control.Background}" CornerRadius="{Binding ActualWidth, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.5, RelativeSource={RelativeSource Self}}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition MinHeight="{x:Static ctrls:ScrollBar.ScrollButtonSize}" Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition MinHeight="{x:Static ctrls:ScrollBar.ScrollButtonSize}" Height="Auto" />
        </Grid.RowDefinitions>
        <RepeatButton Grid.Row="0" AutomationProperties.Name="{x:Static styles:Resources.ScrollUp}" Command="{x:Static ScrollBar.LineUpCommand}" Content="{x:Static styles:Geometries.ScrollBarUpArrow}" Style="{StaticResource ScrollDirectionalButtonStyle}" />
        <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButtonStyle}" />
          </Track.DecreaseRepeatButton>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButtonStyle}" />
          </Track.IncreaseRepeatButton>
          <Track.Thumb>
            <Thumb DataContext="{TemplateBinding ScrollBar.Orientation}" Padding="{TemplateBinding Control.Padding}" VerticalAlignment="Stretch" Style="{StaticResource ThumbStyle}" />
          </Track.Thumb>
        </Track>
        <RepeatButton Grid.Row="2" AutomationProperties.Name="{x:Static styles:Resources.ScrollDown}" Command="{x:Static ScrollBar.LineDownCommand}" Content="{x:Static styles:Geometries.ScrollBarDownArrow}" Style="{StaticResource ScrollDirectionalButtonStyle}" />
      </Grid>
    </Border>
  </ControlTemplate>
  <Style x:Key="{x:Type ctrls:ScrollBar}" TargetType="{x:Type ctrls:ScrollBar}">
    <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillTransparentBrushKey}}" />
    <Setter Property="Focusable" Value="False" />
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.LayerFillDefaultBrushKey}}" />
      </Trigger>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Margin" Value="{x:Static styles:Spacings.HorizontalXXXS}" />
        <Setter Property="Padding" Value="{x:Static styles:Spacings.VerticalXS}" />
        <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
        <Setter Property="Width" Value="Auto" />
      </Trigger>
      <Trigger Property="ScrollBar.Orientation" Value="Vertical">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Margin" Value="{x:Static styles:Spacings.VerticalXXXS}" />
        <Setter Property="Padding" Value="{x:Static styles:Spacings.HorizontalXS}" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
      </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="False" Binding="{Binding AreDynamicScrollBarsEnabled, Source={x:Static styles:VisualOptions.Instance}}" />
          <Condition Value="Horizontal" Binding="{Binding Orientation, RelativeSource={RelativeSource Self}}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="MinHeight" Value="{Binding SystemHorizontalScrollBarHeight, Source={x:Static styles:VisualOptions.Instance}}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Value="False" Binding="{Binding AreDynamicScrollBarsEnabled, Source={x:Static styles:VisualOptions.Instance}}" />
          <Condition Value="Vertical" Binding="{Binding Orientation, RelativeSource={RelativeSource Self}}" />
        </MultiDataTrigger.Conditions>
        <Setter Property="MinWidth" Value="{Binding SystemVerticalScrollBarWidth, Source={x:Static styles:VisualOptions.Instance}}" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>