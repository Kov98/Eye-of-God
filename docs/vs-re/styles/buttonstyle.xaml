<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrls="clr-namespace:Microsoft.VisualStudio.Shell.Controls" xmlns:cvrts="clr-namespace:Microsoft.VisualStudio.Shell.Converters" xmlns:img="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging" xmlns:imgbg="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging" xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell.Styles">
  <Style x:Key="{x:Type ctrls:Button}" BasedOn="{x:Static styles:ShellStyles.ButtonBase}" TargetType="{x:Type ctrls:Button}">
    <Setter Property="ctrls:Button.CornerRadius" Value="{x:Static styles:CornerRadii.M}" />
    <Setter Property="Padding" Value="{x:Static styles:Spacings.HorizontalS}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:Button}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding ctrls:Button.CornerRadius}" Padding="{TemplateBinding Control.Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" MinHeight="{x:Static styles:Sizes.ContentMinHeight}" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ctrls:Button.Kind" Value="Accent">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillDefaultBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillDefaultBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextOnAccentFillPrimaryBrushKey}}" />
        <Setter Property="imgbg:ImageThemingUtilities.ImageBackgroundColor" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillDefaultColorKey}}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ctrls:Button.Kind" Value="Accent" />
          <Condition Property="IsEnabled" Value="False" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillDisabledBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillDisabledBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextOnAccentFillDisabledBrushKey}}" />
        <Setter Property="img:CrispImage.GrayscaleBiasColor" Value="{DynamicResource {x:Static styles:ShellColors.TextOnAccentFillDisabledColorKey}}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ctrls:Button.Kind" Value="Accent" />
          <Condition Property="UIElement.IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillSecondaryBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillSecondaryBrushKey}}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ctrls:Button.Kind" Value="Accent" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillTertiaryBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.AccentFillTertiaryBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextOnAccentFillSecondaryBrushKey}}" />
      </MultiTrigger>
      <Trigger Property="ctrls:Button.Kind" Value="Pill">
        <Setter Property="ctrls:Button.CornerRadius" Value="{Binding ActualHeight, Converter={x:Static cvrts:Converters.MultiplyConverter}, ConverterParameter=0.5, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Static styles:ShellInternalStyles.PillFocusVisual}" />
      </Trigger>
      <Trigger Property="ctrls:Button.Kind" Value="Subtle">
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.ControlFillTransparentBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeTransparentBrushKey}}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ctrls:Button.Kind" Value="Subtle" />
          <Condition Property="UIElement.IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.SubtleFillSecondaryBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.ControlStrokeSecondaryBrushKey}}" />
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="ctrls:Button.Kind" Value="Subtle" />
          <Condition Property="IsPressed" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static styles:ShellColors.SubtleFillTertiaryBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:ShellColors.SubtleFillTertiaryBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:ShellColors.TextFillSecondaryBrushKey}}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>