/* ============================================================================
   GERADO por tools/theme/gen_theme.py — NAO EDITAR A MAO.
   Fonte das cores: tools/theme/roles.json + tokens.json (VS 2026 dark medido)
   Geometria: tools/theme/scale.json (Spacings/CornerRadii/StrokeWidths/Sizes do VS)
   ============================================================================ */

QWidget {
    background: #1C1C1C;
    color: #FFFFFF;
    font-family: "Segoe UI";
    font-size: 12px;
    border: none;
}
QMainWindow, QDialog { background: #1C1C1C; }
QLabel, QCheckBox, QRadioButton { background: transparent; }

/* --- chrome: barra de titulo + menu (30px) --- */
#titleBar, #titleMenuBar, QMenuBar {
    background: #1C1C1C;
    border: none;
    min-height: 30px;
    padding: 0px;
    font-size: 12px;
}
QMenuBar::item { background: transparent; padding: 6px 9px; color: #FFFFFF; }
QMenuBar::item:selected { background: #353535; color: #FFFFFF; }
QMenuBar::item:pressed { background: #3A3A3A; }
QToolButton#titleMin, QToolButton#titleMax, QToolButton#titleClose {
    background: transparent; border: none; color: #FFFFFF;
    min-width: 44px; max-width: 44px;
    min-height: 30px; max-height: 30px;
    padding: 0px; margin: 0px; border-radius: 0px;
}
QToolButton#titleMin:hover, QToolButton#titleMax:hover { background: #353535; }
QToolButton#titleClose:hover { background: #C42B1C; color: #FFFFFF; }

/* --- command bar --- */
QToolBar, QToolBar#mainToolbar {
    background: #262626;
    border: none;
    border-bottom: 1px solid #0E0E0E;
    padding: 3px 8px;
    spacing: 4px;
}
QToolBar::separator { background: #2C2C2C; width: 1px; margin: 4px 6px; }
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px;
    color: #FFFFFF;
}
QToolButton:hover { background: #333333; border-color: #454545; }
QToolButton:pressed { background: #2F2F2F; }
QToolButton:checked { background: #3A3A3A; border-color: #454545; }
QFrame#commandGroup, QWidget#commandGroup {
    background: transparent;
    border: 1px solid #191919;
    border-radius: 6px;
}

/* --- documentos e abas --- */
/* VS medido: o poco do documento tem contorno de 1px accent (x=318 e x=1584) */
QTabWidget#centerTabs::pane {
    background: #1E1E1E;
    border-left: 1px solid #9184EE;
    border-right: 1px solid #9184EE;
    border-bottom: 1px solid #9184EE;
    top: 0px;
}
QTabBar { background: #262626; qproperty-drawBase: 0; }
/* Medido no editor de referencia (zoom 8x): aba ativa com cantos superiores
   de ~6px, fundindo com o editor, e fio accent de 1px no topo. Inativas ficam
   transparentes sobre a tira. */
QTabBar::tab {
    background: transparent;
    color: #929292;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 2px 12px 3px 12px;
    margin: 2px 2px 0 0;
    min-width: 74px;
    min-height: 17px;
    font-size: 12px;
}
QTabBar::tab:hover { background: #353535; color: #FFFFFF; }
QTabBar::tab:selected {
    background: #282828;
    color: #FFFFFF;
    /* a aba ativa do editor de referencia e um "capsule" accent: topo e as duas
       laterais no mesmo tom, fundindo com o fio do poco */
    border-top: 1px solid #9184EE;
    border-left: 1px solid #9184EE;
    border-right: 1px solid #9184EE;
}
QToolButton#tabClose {
    background: transparent; border: none; color: #929292;
    min-width: 14px; min-height: 14px;
    padding: 0px; margin: 0px 2px 0px 0px;
}
QToolButton#tabClose:hover { background: #3A3A3A; color: #FFFFFF; border-radius: 4px; }
QFrame#documentFrame, QFrame#documentBody { background: #1E1E1E; border: none; border-radius: 6px; }

/* --- paineis, docks, arvore, listas --- */
/* O respiro (backdrop) do dock fica no fundo do chrome (#1C1C1C); o painel em
   cima e um "card" com contorno de 1px e cantos de 8px - o mesmo efeito dos
   paineis do editor de referencia. */
QDockWidget { background: #1C1C1C; border: none; }
QDockWidget::title { background: #1C1C1C; }
QWidget#treePanelOuter, QWidget#detailsOuter, QWidget#consoleOuter, QWidget#bottomDock {
    background: #1C1C1C;
    border: none;
}
/* O card do dock agora inclui a barra de titulo; o conteudo fica transparente */
/* card do dock: contorno medido (#454545) e raio 8. O topo fica perfeito porque
   a barra de titulo e embutida/transparente; o canto inferior pode ser coberto
   pela view (o Qt nao recorta filho com raio). */
QFrame#dockCard {
    background: #282828;
    border: 1px solid #454545;
    border-radius: 8px;
}
QWidget#treePanel, QFrame#treePanel,
QWidget#detailsPanel, QFrame#detailsPanel, QWidget#consolePanel,
QWidget#bottomTabs, QWidget#treePanelOuter, QWidget#detailsOuter {
    background: transparent;
    border: none;
}
/* a barra de titulo embutida e transparente: o fundo vem do card (a regra
   global QWidget{background} pintava #1C1C1C por cima do card) */
QFrame#dockCard > QWidget#dockTitleBar { background: transparent; }
QWidget#dockDragStrip { background: transparent; }
QDockWidget::title { padding: 5px 9px; color: #FFFFFF; font-size: 12px; font-weight: 600; }
QTreeView, QTreeView#workTree, QListView {
    background: #282828;
    alternate-background-color: #232323;
    border: none; outline: 0;
    color: #FFFFFF;
    font-size: 12px;
    selection-background-color: #353535;
    selection-color: #FFFFFF;
}
QTreeView::item, QListView::item, QTreeView#workTree::item {
    min-height: 22px; padding: 0px 2px; border: none;
    border-radius: 4px;
}
QTreeView::item:hover, QListView::item:hover {
    background: #303030; border-radius: 4px;
}
QTreeView::item:selected, QListView::item:selected {
    background: #353535; color: #FFFFFF;
    border: 1px solid #454545; border-radius: 4px;
}
QTreeView::branch, QTreeView#workTree::branch { background: #282828; }

/* --- tabelas --- */
QTableView, QTableWidget, QTableView#dataGrid, QTableWidget#dataGrid {
    background: #1F1F1F;
    alternate-background-color: #232323;
    border: none; outline: 0;
    color: #FFFFFF;
    font-size: 12px;
    gridline-color: #0E0E0E;
    selection-background-color: #353535;
    selection-color: #FFFFFF;
}
QTableView::item, QTableWidget::item, QTableView#dataGrid::item, QTableWidget#dataGrid::item {
    border: none; border-bottom: 1px solid #232323; padding: 3px 6px;
}
QTableView::item:selected, QTableWidget::item:selected,
QTableView#dataGrid::item:selected, QTableWidget#dataGrid::item:selected {
    background: #353535; color: #FFFFFF; border-radius: 4px;
}
QTableView::item:hover, QTableWidget::item:hover,
QTableView#dataGrid::item:hover, QTableWidget#dataGrid::item:hover { background: #303030; }
QHeaderView::section {
    background: #282828;
    color: #929292;
    border: none;
    border-right: 1px solid #232323;
    border-bottom: 1px solid #232323;
    padding: 3px 6px;
    font-size: 12px;
    font-weight: 400;
}
QHeaderView::section:hover { background: #303030; color: #FFFFFF; }
QTableCornerButton::section { background: #282828; border: none; }

/* --- console e saida --- */
QPlainTextEdit, QTextEdit {
    background: #1F1F1F;
    border: none;
    color: #929292;
    font-family: "Cascadia Mono", "Consolas";
    font-size: 14px;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QFrame#divider { background: #0E0E0E; border: none; max-height: 1px; }

/* --- controles: unico lugar com stroke --- */
QLineEdit, QComboBox, QSpinBox {
    background: #282828;
    border: 1px solid #2C2C2C;
    border-radius: 6px;
    padding: 4px 6px;
    color: #FFFFFF;
    min-height: 18px;
    font-size: 12px;
    selection-background-color: #094771;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QComboBox:hover { border-color: #454545; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #9184EE; }
QLineEdit:disabled, QComboBox:disabled { color: #777777; background: #262626; border-color: #191919; }
QComboBox::drop-down { border: none; width: 22px; }
/* VS medido (x=345 em y=31..58): combos da command bar sao planos, interior
   #262626 igual ao da barra; a caixa so aparece no hover/foco. */
/* VS medido (caixa de entrada da toolbar): fundo #333333, contorno 1px
   #353535, raio 4 e 24px de altura (bordas em y=33 e y=56 do recorte) */
QComboBox#commandCombo {
    background: #333333;
    border: 1px solid #353535;
    border-radius: 6px;
    padding: 0px 18px 0px 6px;
    min-height: 22px;
    color: #F0F0F0;
}
QComboBox#commandCombo:hover { background: #333333; border-color: #454545; }
QComboBox#commandCombo:focus { background: #2B2B2B; border-color: #9184EE; }
/* seta do combo: chevron monoline cinza (VS medido: ~#A0A0A0 dentro da caixa) */
QComboBox#commandCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 18px;
    border: none;
}
QComboBox#commandCombo::down-arrow {
    image: url("@APP@/icons/chevron_down_dim.png");
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background: #282828; border: 1px solid #454545; color: #FFFFFF;
    selection-background-color: #353535; selection-color: #FFFFFF;
}
QPushButton {
    background: #262626;
    color: #FFFFFF;
    border: 1px solid #2C2C2C;
    border-radius: 6px;
    padding: 5px 12px;
    min-height: 24px;
    font-size: 12px;
}
QPushButton:hover { background: #333333; border-color: #454545; }
QPushButton:pressed { background: #2F2F2F; }
QPushButton:disabled { background: #1C1C1C; color: #777777; border-color: #191919; }
QCheckBox { spacing: 6px; color: #FFFFFF; font-size: 12px; }
QCheckBox::indicator {
    width: 15px; height: 15px;
    border: 1px solid #454545;
    border-radius: 4px;
    background: #282828;
}
QCheckBox::indicator:hover { border-color: #929292; }
QCheckBox::indicator:checked { background: #9184EE; border-color: #9184EE; }
QGroupBox {
    background: #282828;
    border: none;
    border-radius: 6px;
    margin-top: 18px;
    padding: 10px 10px 8px 10px;
}
QGroupBox::title {
    subcontrol-origin: margin; left: 10px; padding: 0 6px;
    color: #929292; font-size: 11px; font-weight: 600;
}

/* --- barra de status --- */
QStatusBar {
    background: #262626;
    border: none;
    border-top: 1px solid #0E0E0E;
    color: #929292;
    padding: 0px 8px;
    min-height: 24px;
    font-size: 12px;
}
QStatusBar QLabel { color: #929292; font-size: 12px; }
QLabel#statusMono { font-family: "Cascadia Mono", "Consolas"; color: #929292; }

/* --- scrollbar 8px, sem setas --- */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0px; border: none; }
QScrollBar::handle:vertical { background: #454545; min-height: 24px; border: none; border-radius: 6px; }
QScrollBar::handle:vertical:hover { background: #777777; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0px; border: none; }
QScrollBar::handle:horizontal { background: #454545; min-width: 24px; border: none; border-radius: 6px; }
QScrollBar::handle:horizontal:hover { background: #777777; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0px; width: 0px; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* --- overlays --- */
QMenu {
    background: #1F1F1F;
    border: 1px solid #454545;
    border-radius: 6px;
    padding: 3px;
    color: #FFFFFF;
    font-size: 12px;
}
/* itens de menu em pilula (o editor de referencia arredonda os itens) */
QMenu::item { padding: 5px 20px 5px 10px; border: none; border-radius: 4px; margin: 1px 4px; }
QMenu::item:selected { background: #353535; color: #FFFFFF; }
QMenu::separator { height: 1px; background: #232323; margin: 4px 8px; }
QToolTip {
    background: #1F1F1F; color: #FFFFFF;
    border: 1px solid #454545; border-radius: 6px; padding: 4px 6px;
}
QSplitter::handle { background: #0E0E0E; width: 1px; height: 1px; }
QSplitter::handle:hover { background: #9184EE; }

/* --- rotulos --- */
QLabel#panelTitle, QLabel#explorerTitle { color: #929292; font-size: 11px; font-weight: 600; }
QLabel#muted { color: #929292; font-size: 12px; }
QLabel#monoValue { color: #FFFFFF; font-family: "Cascadia Mono", "Consolas"; font-size: 12px; }
QLabel#projectName { color: #FFFFFF; font-size: 12px; }
QLabel#docBreadcrumb, QLabel#docScope { color: #929292; font-size: 12px; }
QLabel#emptyState {
    background: #1F1F1F; border: 1px dashed #454545;
    border-radius: 6px; color: #929292; font-size: 12px; padding: 20px;
}
QToolButton#titleMenuButton {
    background: transparent;
    border: none;
    border-radius: 0px;
    /* medido: os itens de menu do VS chegam a #FFFFFF; o nosso parava em #E6E6E6 */
    color: #FFFFFF;
    font-size: 12px;
    /* VS medido: passo entre itens = largura do texto + 16px (8px por lado) */
    padding: 0px 4px;
    min-height: 30px;
}
QToolButton#titleMenuButton:hover { background: #353535; color: #FFFFFF; }
QToolButton#titleMenuButton:pressed { background: #3A3A3A; }
QToolButton#titleMenuButton::menu-indicator { image: none; width: 0px; }

/* --- linha de menu: busca e chip da solucao (modelo VS) --- */
/* VS 2026: a busca do titulo e plana (sem caixa) e so ganha caixa no hover/foco */
QLineEdit#titleSearch {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 4px 2px 2px;
    color: #C8C8C8;
    font-size: 12px;
}
QLineEdit#titleSearch:hover { background: #262626; border-color: #333333; }
QLineEdit#titleSearch:focus { background: #1F1F1F; border-color: #454545; color: #E6E6E6; }
QLabel#userAvatar {
    background: #0E639C;
    color: #FFFFFF;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
}
QToolButton#titleSearchMenu {
    background: transparent; border: none; color: #CECECE; font-size: 9px;
}
QToolButton#titleSearchMenu:hover { background: #333333; border-radius: 4px; color: #FFFFFF; }
/* VS medido (x=800): campo do workspace = #292929 com 1px #0E0E0E em cima/embaixo,
   22px de altura, sem cantos arredondados e texto em negrito */
QLabel#projectName {
    background: #292929;
    border-left: none;
    border-right: none;
    border-top: 1px solid #0E0E0E;
    border-bottom: 1px solid #0E0E0E;
    border-radius: 0px;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    padding: 0px 8px;
}

/* --- painel Detalhes: anatomia do painel de Source Control (medido #353535) --- */
/* barra interna do painel: faixa reta de ponta a ponta (o raio agora e do card) */
QWidget#detailsToolbar { background: #353535; border: none; }
QComboBox#detailsScope {
    background: transparent; border: none; border-radius: 4px;
    color: #E6E6E6; padding: 0px 16px 0px 6px; font-size: 12px;
}
QComboBox#detailsScope:hover { background: #3D3D3D; }
QComboBox#detailsScope::drop-down { border: none; width: 14px; }
QToolButton#detailsGlyph {
    background: transparent; border: none; border-radius: 4px;
    color: #D6D6D6; font-size: 12px;
}
QToolButton#detailsGlyph:hover { background: #3D3D3D; color: #FFFFFF; }
QLabel#detailsSummary { color: #929292; font-size: 11px; padding: 6px 10px 0px 10px; }
QLineEdit#detailsFilter {
    background: #353535; border: 1px solid #3A3A3A; border-radius: 6px;
    padding: 2px 6px; color: #E6E6E6; font-size: 12px;
}
QLineEdit#detailsFilter:hover { border-color: #454545; }
QLineEdit#detailsFilter:focus { border-color: #9184EE; }
QToolButton#detailsPrimary {
    background: #353535; border: 1px solid #3A3A3A; border-radius: 6px;
    color: #FFFFFF; font-size: 12px; padding: 0px 10px;
}
QToolButton#detailsPrimary:hover { background: #3D3D3D; border-color: #454545; }
QPushButton#detailsSection {
    background: transparent; border: none; border-radius: 0px;
    color: #FFFFFF; font-size: 12px; font-weight: 600;
    text-align: left; padding: 0px 8px; margin: 0px 4px; min-height: 22px;
}
QPushButton#detailsSection:hover { background: #303030; border-radius: 4px; }
QWidget#detailsSectionBody { background: transparent; }
QWidget#detailsRow { background: transparent; }
QScrollArea#detailsScroll, QScrollArea#detailsScroll > QWidget > QWidget { background: transparent; border: none; }
QLabel#detailsKey { color: #929292; font-size: 11px; }
/* badge de status: no painel de referencia cada linha termina numa etiqueta curta */
QLabel#detailsBadge {
    background: #2D3B2D; color: #8FD18F; border-radius: 4px;
    padding: 0px 6px; font-size: 11px;
}
QLabel#detailsNote { color: #929292; font-size: 11px; padding: 6px 10px 8px 10px; }

/* semanticos (nao sao tema): severidade e alerta */
QLabel#warning { background: #332B00; border: none; border-left: 3px solid #FFC107; border-radius: 6px; color: #FFE082; padding: 8px 10px; }
QLabel#cloudStatus, QLabel#formHint { background: #1F1F1F; border: 1px solid #191919; border-left: 3px solid #9184EE; border-radius: 6px; color: #929292; padding: 6px 8px; }
QLabel#cloudStatus[failed="true"], QLabel#formHint[error="true"] { background: #2A1E1E; border-color: #5A3030; border-left-color: #C0504D; color: #E6B8B4; }
